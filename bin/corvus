#!/data/data/com.termux/files/usr/bin/bash

BASE="$HOME/corvus"
source "$BASE/config/corvus.env"
source "$BASE/config/runtime.env"

MODEL="$BASE/data/models/qwen2.5-1.5b-instruct-q4_k_m.gguf"

avail_mb() {
    awk '/MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo
}

case "$1" in
  version)
    echo "$CORVUS_VERSION"
    ;;
  help)
    shift
    ~/corvus/bin/corvus-help
    ;;
  library)
    shift
    ~/corvus/bin/library-stats.py
    ;;
  search)
    shift
    ~/corvus/bin/search-library.py "$@"
    ;;
  ask)
    shift
    exec "$HOME/corvus/bin/corvus-ask.py" "$@"
    ;;
  pipeline)
    shift
    ~/corvus/bin/corvus-pipeline "$@"
    ;;
    status)
        RAM=$(avail_mb)
        echo "=== CORVUS V1 ==="
        echo "RAM available: ${RAM} MB"

        if [ "$RAM" -lt "$CORVUS_CRITICAL_RAM_MB" ]; then
            echo "State: CRITICAL"
        elif [ "$RAM" -lt "$CORVUS_LOW_RAM_MB" ]; then
            echo "State: CONSTRAINED"
        else
            echo "State: NORMAL"
        fi

        [ -f "$MODEL" ] && echo "Model: READY" || echo "Model: MISSING"
        ;;

    health)
        "$BASE/bin/health"
        ;;

    *)
        echo "CORVUS V1"
        echo "Commands: status | health"
        ;;
esac
