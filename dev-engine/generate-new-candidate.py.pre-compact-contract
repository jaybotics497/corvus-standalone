#!/usr/bin/env python3
from pathlib import Path
import re
import subprocess
import sys

if len(sys.argv) != 3:
    print("USAGE: generate-new-candidate.py JOB TARGET")
    raise SystemExit(1)

home = Path.home()
dev = home / "corvus-dev"
stage = dev / "staging/corvus"

job = Path(sys.argv[1])
target = sys.argv[2]

if target != "bin/dev-evidence.py":
    print("NEW CANDIDATE: BLOCKED - unsupported target")
    raise SystemExit(2)

contract = """
Build Evidence Bridge V1 as one complete Python executable.

IMMUTABLE CONTRACT:
- Development-only, read-only evidence retrieval.
- Allowed roots exactly: ~/corvus and ~/corvus-dev.
- Input is 1 to 6 explicit requested file paths.
- No recursive directory traversal.
- No shell execution.
- No arbitrary command execution.
- No writes to inspected targets.
- MAX_FILES = 6.
- MAX_FILE_BYTES = 30000.
- MAX_TOTAL_BYTES = 90000 accepted content bytes.
- Canonical containment must be verified before reading.
- Reject symlinks for content retrieval.
- Always reject ~/corvus/api/token.
- Reject credentials, tokens, private keys, keystores and .env.
- Reject model binaries, databases, APK, DEX, CLASS, pyc, .git,
  backups, generated files and build artifacts.
- Only regular readable textual files may be accepted.
- Perform safety checks before content reads.
- Reject content containing NUL bytes.
- Decode accepted content as strict UTF-8.
- Accepted evidence must report canonical_path, size_bytes,
  and textual_content.
- Rejected or unavailable evidence must report requested_path,
  status and deterministic reason.
- Do not infer facts from evidence.
- Do not modify production.
- Do not execute inspected source files.

Return ONLY one complete file between these exact markers:

<CODE>
#!/usr/bin/env python3
...complete implementation...
</CODE>

Do not return explanations outside the markers.
"""

prompt = f"""{contract}

DEVELOPMENT JOB:
{job.read_text()}

AUTHORIZED NEW TARGET:
{target}
"""

env = dict(__import__("os").environ)
env["CORVUS_MAX_TOKENS"] = "2048"

result = subprocess.run(
    [str(home / "corvus/bin/infer"), prompt],
    capture_output=True,
    text=True,
    env=env,
)

raw = dev / "changes/last-new-candidate-raw.txt"
raw.parent.mkdir(parents=True, exist_ok=True)
raw.write_text(result.stdout)

matches = re.findall(r"<CODE>\s*(.*?)\s*</CODE>", result.stdout, re.DOTALL)

if not matches:
    print("NEW CANDIDATE: FAILED - CODE markers missing")
    print(f"RAW OUTPUT: {raw}")
    raise SystemExit(3)

candidate = matches[-1].strip() + "\n"

if not candidate.startswith("#!/usr/bin/env python3"):
    print("NEW CANDIDATE: FAILED - invalid Python candidate")
    raise SystemExit(4)

destination = stage / target
destination.parent.mkdir(parents=True, exist_ok=True)
destination.write_text(candidate)
destination.chmod(0o700)

print("NEW CANDIDATE: CORVUS GENERATED")
print(f"TARGET: {target}")
print(f"BYTES: {len(candidate.encode('utf-8'))}")
print("NEW CANDIDATE: STAGED")
